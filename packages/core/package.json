{
  "name": "@shuimo-design/core",
  "version": "1.0.0-beta.2",
  "description": "水墨风组件库的无框架内核 —— 墨迹生成、状态控制器与全部样式",
  "keywords": [
    "chinese",
    "headless",
    "ink",
    "shuimo",
    "ui"
  ],
  "homepage": "https://shuimo.design",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuimo-design/shuimo-ui-next.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@shuimo-design/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ink": {
      "@shuimo-design/source": "./src/ink/index.ts",
      "types": "./dist/ink.d.ts",
      "import": "./dist/ink.js"
    },
    "./style.css": {
      "@shuimo-design/source": "./src/styles/index.css",
      "default": "./dist/style.css"
    },
    "./css/*": "./dist/css/*",
    "./styles": {
      "@shuimo-design/source": "./src/styles/manifest.ts",
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsx scripts/build-css.ts && pnpm check:style",
    "check:style": "tsx scripts/check-style.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints style.css \"css/*\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "catalog:",
    "tsx": "^4.21.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

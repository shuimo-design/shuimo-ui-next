{
  "name": "@shuimo-design/ui",
  "version": "1.0.0-alpha.0",
  "description": "水墨风 Vue 组件库（next）— 程序化宣纸、山水、墨晕与笔触",
  "keywords": [
    "chinese",
    "component-library",
    "ink",
    "shuimo",
    "ui",
    "vue"
  ],
  "homepage": "https://shuimo.design",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuimo-design/shuimo-ui-next.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "web-types.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ink": {
      "types": "./dist/ink.d.ts",
      "import": "./dist/ink.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && pnpm gen:meta && pnpm check:style",
    "check:style": "tsx scripts/check-style.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test",
    "bench": "BENCH=1 vp test bench/",
    "gen:meta": "tsx scripts/gen-meta.ts",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints style.css"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@vueuse/core": "^14.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "^1.63.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "unplugin-vue": "^7.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "^3.1.0",
    "vue": "catalog:",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "web-types": "web-types.json"
}

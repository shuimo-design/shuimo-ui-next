{
  "name": "shuimo-ui-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C playground dev",
    "build": "pnpm -C packages/ui build",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "pnpm -C packages/ui test",
    "bench": "pnpm -C packages/ui bench",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4"
}

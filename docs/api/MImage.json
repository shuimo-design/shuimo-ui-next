{
  "name": "MImage",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MImage"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MImage"
    }
  },
  "attributes": [
    {
      "name": "src",
      "description": "图片地址",
      "required": true,
      "value": {
        "kind": "expression",
        "type": "string"
      },
      "react": {
        "name": "src"
      }
    },
    {
      "name": "alt",
      "description": "替代文字",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "alt"
      }
    },
    {
      "name": "fit",
      "description": "图片如何填满容器，对应 CSS object-fit；默认按图片本身尺寸",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "ImageFit | undefined"
      },
      "react": {
        "name": "fit"
      }
    },
    {
      "name": "width",
      "description": "容器宽度，数字按 px",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "width"
      }
    },
    {
      "name": "height",
      "description": "容器高度，数字按 px",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "height"
      }
    },
    {
      "name": "lazy",
      "description": "进入视口附近才加载（原生 loading=\"lazy\"）",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "lazy"
      }
    },
    {
      "name": "preview",
      "description": "点击打开全屏预览，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "preview"
      }
    },
    {
      "name": "previewSrcList",
      "description": "预览时可切换的图片列表；不传只预览自己",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string[] | undefined"
      },
      "react": {
        "name": "previewSrcList"
      }
    },
    {
      "name": "initialIndex",
      "description": "打开预览时先显示列表里的第几张（从 0 起）；不传就找 src 在列表里的位置，找不到从第一张起",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "initialIndex"
      }
    },
    {
      "name": "zIndex",
      "description": "预览层的 z-index，默认 900（和弹窗一层）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "zIndex"
      }
    },
    {
      "name": "seed",
      "description": "预览层挂牌墨花的随机种子，默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    }
  ],
  "events": [
    {
      "name": "load",
      "description": "图片加载完成",
      "react": {
        "name": "onLoad"
      }
    },
    {
      "name": "error",
      "description": "图片加载失败",
      "react": {
        "name": "onError"
      }
    },
    {
      "name": "show",
      "description": "预览打开",
      "react": {
        "name": "onShow"
      }
    },
    {
      "name": "close",
      "description": "预览关闭",
      "react": {
        "name": "onClose"
      }
    }
  ],
  "slots": [
    {
      "name": "placeholder",
      "description": "加载中的占位；不给就是一块骨架",
      "react": {
        "name": "renderPlaceholder"
      }
    },
    {
      "name": "error",
      "description": "加载失败时的内容；不给就显示「加载失败」",
      "react": {
        "name": "renderError"
      }
    }
  ]
}

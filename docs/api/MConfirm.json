{
  "name": "MConfirm",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MConfirm"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MConfirm"
    }
  },
  "attributes": [
    {
      "name": "content",
      "description": "正文；也可以用默认插槽",
      "default": "\"\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "content"
      }
    },
    {
      "name": "title",
      "description": "标题，不传就不渲染",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "title"
      }
    },
    {
      "name": "mask",
      "description": "遮罩配置，默认 { show: true, clickClose: true }；传布尔只控制显示",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | ModalMask | undefined"
      },
      "react": {
        "name": "mask"
      }
    },
    {
      "name": "teleport",
      "description": "传送目标：true 到 body、false 原地渲染、字符串为选择器；默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | boolean | undefined"
      },
      "react": {
        "name": "teleport"
      }
    },
    {
      "name": "confirmText",
      "description": "确定按钮文字，默认「确定」",
      "default": "\"确定\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "confirmText"
      }
    },
    {
      "name": "cancelText",
      "description": "取消按钮文字，默认「取消」",
      "default": "\"取消\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "cancelText"
      }
    },
    {
      "name": "closeOnEsc",
      "description": "按 Esc 是否等同取消，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "closeOnEsc"
      }
    },
    {
      "name": "seed",
      "description": "笔触种子，默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    },
    {
      "name": "open",
      "description": "是否显示；函数式的 MConfirm.show() 不用管它",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "open",
        "extra": ["defaultOpen", "onOpenChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:open"
    },
    {
      "name": "confirm",
      "description": "点了确定",
      "react": {
        "name": "onConfirm"
      }
    },
    {
      "name": "cancel",
      "description": "点了取消、遮罩或按了 Esc",
      "react": {
        "name": "onCancel"
      }
    },
    {
      "name": "closed",
      "description": "离场动画结束",
      "react": {
        "name": "onClosed"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "替代 content",
      "react": {
        "name": "children"
      }
    },
    {
      "name": "footer",
      "description": "替代底部按钮，参数里给了确定 / 取消两个方法",
      "react": {
        "name": "footer"
      }
    }
  ]
}

{
  "name": "MTree",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MTree"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MTree"
    }
  },
  "attributes": [
    {
      "name": "data",
      "description": "树数据",
      "required": true,
      "value": {
        "kind": "expression",
        "type": "TreeNodeData[]"
      },
      "react": {
        "name": "data"
      }
    },
    {
      "name": "fieldNames",
      "description": "字段名映射",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "TreeFieldNames | undefined"
      },
      "react": {
        "name": "fieldNames"
      }
    },
    {
      "name": "checkable",
      "description": "显示勾选框",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "checkable"
      }
    },
    {
      "name": "checkStrictly",
      "description": "勾选时父子不联动（各自独立）",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "checkStrictly"
      }
    },
    {
      "name": "defaultExpandAll",
      "description": "初始展开全部",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "defaultExpandAll"
      }
    },
    {
      "name": "selectable",
      "description": "点击节点文字可选中",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "selectable"
      }
    },
    {
      "name": "expandedKeys",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "TreeKey[] | undefined"
      },
      "react": {
        "name": "expandedKeys",
        "extra": ["defaultExpandedKeys", "onExpandedKeysChange"]
      }
    },
    {
      "name": "checkedKeys",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "TreeKey[] | undefined"
      },
      "react": {
        "name": "checkedKeys",
        "extra": ["defaultCheckedKeys", "onCheckedKeysChange"]
      }
    },
    {
      "name": "selectedKey",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "TreeKey | undefined"
      },
      "react": {
        "name": "selectedKey",
        "extra": ["defaultSelectedKey", "onSelectedKeyChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:expandedKeys"
    },
    {
      "name": "update:checkedKeys"
    },
    {
      "name": "update:selectedKey"
    },
    {
      "name": "nodeClick",
      "description": "点击节点行（禁用节点不触发）；键盘回车 / 空格也算",
      "react": {
        "name": "onNodeClick"
      }
    },
    {
      "name": "check",
      "description": "勾选态变化，带上变化后的全部已勾选 key",
      "react": {
        "name": "onCheck"
      }
    },
    {
      "name": "expand",
      "description": "展开 / 收起",
      "react": {
        "name": "onExpand"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "自定义节点文字，作用域 { node, level }"
    }
  ]
}

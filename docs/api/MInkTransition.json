{
  "name": "MInkTransition",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MInkTransition"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MInkTransition"
    }
  },
  "attributes": [
    {
      "name": "duration",
      "description": "进入时长 ms，默认 900",
      "default": "900",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "duration"
      }
    },
    {
      "name": "leaveDuration",
      "description": "离开时长 ms，默认 600",
      "default": "600",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "leaveDuration"
      }
    },
    {
      "name": "appear",
      "description": "首次渲染也播放，默认 false",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "appear"
      }
    },
    {
      "name": "mode",
      "description": "透传给 <Transition> 的 mode",
      "default": "\"default\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"default\" | \"in-out\" | \"out-in\" | undefined"
      }
    },
    {
      "name": "reducedMotion",
      "description": "强制跳过动画；未传则跟随 prefers-reduced-motion",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "reducedMotion"
      }
    },
    {
      "name": "seed",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    },
    {
      "name": "raggedness",
      "description": "毛边幅度（相对遮罩宽度的百分比），默认 6",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "raggedness"
      }
    },
    {
      "name": "softness",
      "description": "边缘晕开，默认 1.5",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "softness"
      }
    },
    {
      "name": "direction",
      "description": "扫入方向：right = 从左向右显现",
      "default": "\"right\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"right\" | \"left\" | \"down\" | \"up\" | undefined"
      },
      "react": {
        "name": "direction"
      }
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "react": {
        "name": "children"
      }
    }
  ]

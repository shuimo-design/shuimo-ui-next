{
  "name": "MTable",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MTable"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MTable"
    }
  },
  "attributes": [
    {
      "name": "data",
      "description": "表格数据，一项一行",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "readonly Row[] | undefined"
      },
      "react": {
        "name": "data"
      }
    },
    {
      "name": "columns",
      "description": "列声明，顺序就是列序；不传则从子组件 MTableColumn 上收集",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "readonly TableColumnConfig<Row, unknown>[] | undefined"
      },
      "react": {
        "name": "columns"
      }
    },
    {
      "name": "rowKey",
      "description": "行的 key：字段名或函数，不传按下标",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "TableRowKey<Row> | undefined"
      },
      "react": {
        "name": "rowKey"
      }
    },
    {
      "name": "height",
      "description": "表格最大高度（CSS 长度）；超出后表体内滚动、表头固定",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "height"
      }
    },
    {
      "name": "align",
      "description": "单元格默认对齐，默认居中",
      "default": "\"center\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "TableAlign | undefined"
      },
      "react": {
        "name": "align"
      }
    },
    {
      "name": "stripe",
      "description": "斑马纹：偶数行铺一层淡墨",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "stripe"
      }
    },
    {
      "name": "emptyText",
      "description": "没有数据时的文字；empty 插槽优先",
      "default": "\"暂无数据\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "emptyText"
      }
    }
  ],
  "events": [
    {
      "name": "rowClick",
      "description": "点击某一行",
      "react": {
        "name": "onRowClick"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "放 MTableColumn，用组件的方式声明列（语法糖；传了 columns 就不看这里）",
      "react": {
        "name": "children"
      }
    },
    {
      "name": "empty",
      "description": "没有数据时显示的内容",
      "react": {
        "name": "empty"
      }
    }
  ]
}

{
  "name": "MRadioGroup",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MRadioGroup"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MRadioGroup"
    }
  },
  "attributes": [
    {
      "name": "disabled",
      "description": "整组禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "direction",
      "description": "横排（默认）还是竖排",
      "default": "\"horizontal\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"horizontal\" | \"vertical\" | undefined"
      },
      "react": {
        "name": "direction"
      }
    },
    {
      "name": "name",
      "description": "组内所有原生 radio 共用的 name；不传则自动生成，保证方向键能在组内切换",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "name"
      }
    },
    {
      "name": "modelValue",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "RadioValue | undefined"
      },
      "react": {
        "name": "value",
        "extra": ["defaultValue", "onValueChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "用户操作导致选中项变化",
      "react": {
        "name": "onChange"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "react": {
        "name": "children"
      }
    }
  ]
}

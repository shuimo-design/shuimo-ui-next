{
  "name": "MShanShui",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MShanShui"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MShanShui"
    }
  },
  "attributes": [
    {
      "name": "seed",
      "description": "生成种子；同 seed 同一幅山水（山形、日头位置、雁阵、孤舟都由它定）。默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    },
    {
      "name": "tier",
      "description": "强制特效档位：0 纯色分层、不动；≥1 SVG 山水 + 视差。默认按设备检测",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "InkTier | undefined"
      },
      "react": {
        "name": "tier"
      }
    },
    {
      "name": "height",
      "description": "横幅高度，数字按 px，默认 \"60vh\"",
      "default": "\"60vh\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "height"
      }
    },
    {
      "name": "layers",
      "description": "远山层数 2–5，默认 3",
      "default": "3",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "layers"
      }
    },
    {
      "name": "sun",
      "description": "画朱砂日，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "sun"
      }
    },
    {
      "name": "geese",
      "description": "画雁阵，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "geese"
      }
    },
    {
      "name": "boat",
      "description": "画孤舟，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "boat"
      }
    },
    {
      "name": "parallax",
      "description": "视差：scroll 跟随滚动、pointer 跟随鼠标、none 不动。默认 scroll；prefers-reduced-motion 下自动不动",
      "default": "\"scroll\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "ShanShuiParallax | undefined"
      },
      "react": {
        "name": "parallax"
      }
    },
    {
      "name": "palette",
      "description": "配色：ink 跟随纸色，dawn 暖调，dusk 青灰。默认 ink",
      "default": "\"ink\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "ShanShuiPalette | undefined"
      },
      "react": {
        "name": "palette"
      }
    }
  ],
  "events": [
    {
      "name": "ready",
      "description": "全部图层解码完成、画面淡入时触发一次",
      "react": {
        "name": "onReady"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "覆盖在画面上的标题内容，居中",
      "react": {
        "name": "children"
      }
    }
  ]
}

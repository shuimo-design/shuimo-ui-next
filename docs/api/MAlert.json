{
  "name": "MAlert",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MAlert"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MAlert"
    }
  },
  "attributes": [
    {
      "name": "type",
      "description": "语义类型：success 石绿、warn 藤黄、danger 朱砂、info 花青，默认 info",
      "default": "\"info\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "AlertType | undefined"
      },
      "react": {
        "name": "type"
      }
    },
    {
      "name": "title",
      "description": "标题",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "title"
      }
    },
    {
      "name": "description",
      "description": "辅助说明，也可用默认插槽",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "description"
      }
    },
    {
      "name": "closable",
      "description": "显示关闭按钮，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "closable"
      }
    },
    {
      "name": "showIcon",
      "description": "显示状态徽记，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "showIcon"
      }
    },
    {
      "name": "center",
      "description": "文字居中",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "center"
      }
    },
    {
      "name": "effect",
      "description": "light 淡底 + 语义色边和徽记；dark 语义色底 + 白字，默认 light",
      "default": "\"light\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "AlertEffect | undefined"
      },
      "react": {
        "name": "effect"
      }
    },
    {
      "name": "seed",
      "description": "左侧笔触线和徽记的随机种子",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    }
  ],
  "events": [
    {
      "name": "close",
      "description": "点了关闭按钮；随后组件自己隐藏",
      "react": {
        "name": "onClose"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "说明文字，优先于 description",
      "react": {
        "name": "children"
      }
    },
    {
      "name": "title",
      "description": "标题，优先于 title",
      "react": {
        "name": "title"
      }
    },
    {
      "name": "icon",
      "description": "替换状态徽记",
      "react": {
        "name": "icon"
      }
    },
    {
      "name": "action",
      "description": "右侧操作区（按钮、链接）",
      "react": {
        "name": "action"
      }
    }
  ]
}

{
  "name": "MCheckbox",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MCheckbox"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MCheckbox"
    }
  },
  "attributes": [
    {
      "name": "value",
      "description": "放进 CheckboxGroup 时用来标识自己的值",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "CheckboxValue | undefined"
      },
      "react": {
        "name": "value"
      }
    },
    {
      "name": "label",
      "description": "文字；默认插槽优先",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "label"
      }
    },
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "indeterminate",
      "description": "半选态（只影响外观，不影响值）",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "indeterminate"
      }
    },
    {
      "name": "name",
      "description": "原生 name",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "name"
      }
    },
    {
      "name": "modelValue",
      "description": "是否勾选",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "checked",
        "extra": ["defaultChecked", "onCheckedChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "用户操作导致勾选态变化",
      "react": {
        "name": "onChange"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "复选框的文字；给了就盖掉 label 属性",
      "react": {
        "name": "children"
      }
    }
  ]
}

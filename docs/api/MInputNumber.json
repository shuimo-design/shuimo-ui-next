{
  "name": "MInputNumber",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MInputNumber"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MInputNumber"
    }
  },
  "attributes": [
    {
      "name": "min",
      "description": "最小值，默认 -Infinity",
      "default": "-Infinity",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "min"
      }
    },
    {
      "name": "max",
      "description": "最大值，默认 Infinity",
      "default": "Infinity",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "max"
      }
    },
    {
      "name": "step",
      "description": "按钮 / 方向键每次增减的量，默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "step"
      }
    },
    {
      "name": "precision",
      "description": "小数位数；不传则不限制",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "precision"
      }
    },
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "readonly",
      "description": "只读：不能键入也不能用按钮增减",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "readonly"
      }
    },
    {
      "name": "placeholder",
      "description": "占位文字",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "placeholder"
      }
    },
    {
      "name": "controls",
      "description": "两侧显示减 / 加按钮，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "controls"
      }
    },
    {
      "name": "name",
      "description": "原生 name",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "name"
      }
    },
    {
      "name": "modelValue",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "value",
        "extra": [
          "defaultValue",
          "onValueChange"
        ]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "值提交后（失焦、回车、按钮或方向键增减），参数是新值与旧值",
      "react": {
        "name": "onChange"
      }
    },
    {
      "name": "input",
      "description": "每次键入，参数是清洗后的文本（可能是 `-`、`1.` 这类中间态）",
      "react": {
        "name": "onInput"
      }
    },
    {
      "name": "focus",
      "react": {
        "name": "onFocus"
      }
    },
    {
      "name": "blur",
      "react": {
        "name": "onBlur"
      }
    }
  ],
  "slots": []
}

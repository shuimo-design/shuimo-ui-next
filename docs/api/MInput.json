{
  "name": "MInput",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MInput"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MInput"
    }
  },
  "attributes": [
    {
      "name": "type",
      "description": "原生 type；textarea 时渲染多行文本框",
      "default": "\"text\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "InputType | undefined"
      },
      "react": {
        "name": "type"
      }
    },
    {
      "name": "placeholder",
      "description": "占位文字",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "placeholder"
      }
    },
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "readonly",
      "description": "只读",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "readonly"
      }
    },
    {
      "name": "clearable",
      "description": "有内容时显示清空按钮",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "clearable"
      }
    },
    {
      "name": "showPassword",
      "description": "password 时显示\"看一眼\"切换按钮",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "showPassword"
      }
    },
    {
      "name": "maxlength",
      "description": "最大字数（原生 maxlength）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "maxlength"
      }
    },
    {
      "name": "showCount",
      "description": "显示字数统计；有 maxlength 时显示为 `n / max`",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "showCount"
      }
    },
    {
      "name": "rows",
      "description": "textarea 行数，默认 3",
      "default": "3",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "rows"
      }
    },
    {
      "name": "resize",
      "description": "textarea 能否拖拽改大小，默认 vertical",
      "default": "\"vertical\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "InputResize | undefined"
      },
      "react": {
        "name": "resize"
      }
    },
    {
      "name": "name",
      "description": "原生 name",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "name"
      }
    },
    {
      "name": "autocomplete",
      "description": "原生 autocomplete",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "autocomplete"
      }
    },
    {
      "name": "autofocus",
      "description": "挂载后自动聚焦",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "autofocus"
      }
    },
    {
      "name": "modelValue",
      "default": "\"\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "value",
        "extra": [
          "defaultValue",
          "onValueChange"
        ]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "input",
      "description": "每次输入",
      "react": {
        "name": "onInput"
      }
    },
    {
      "name": "change",
      "description": "值提交（原生 change：失焦或回车）",
      "react": {
        "name": "onChange"
      }
    },
    {
      "name": "focus",
      "react": {
        "name": "onFocus"
      }
    },
    {
      "name": "blur",
      "react": {
        "name": "onBlur"
      }
    },
    {
      "name": "clear",
      "description": "点了清空按钮",
      "react": {
        "name": "onClear"
      }
    }
  ],
  "slots": [
    {
      "name": "prefix",
      "description": "输入框前的内容（图标、单位）",
      "react": {
        "name": "prefix"
      }
    },
    {
      "name": "suffix",
      "description": "输入框后的内容",
      "react": {
        "name": "suffix"
      }
    }
  ]
}

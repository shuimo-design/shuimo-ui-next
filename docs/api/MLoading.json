      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "size"
      }
    },
    {
      "name": "mask",
      "description": "遮罩模式：铺满最近的定位父元素并把内容盖住（父元素要 position: relative，v-loading 指令会自动加）",

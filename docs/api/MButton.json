{
  "name": "MButton",
  "source": {
    "module": "@shuimo-design/ui",
    "symbol": "MButton"
  },
  "attributes": [
    {
      "name": "type",
      "description": "按钮语义类型：default 灰蓝、primary 蓝、confirm 青、error 红、warning 黄，都是实色块；text 只有文字",
      "default": "\"default\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "ButtonType | undefined"
      }
    },
    {
      "name": "text",
      "description": "按钮文字，有默认插槽时被插槽覆盖",
      "default": "\"\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      }
    },
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "loading",
      "description": "加载中：文字前出现旋转墨点，期间不响应点击",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "href",
      "description": "渲染为 a 标签时的链接地址",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      }
    },
    {
      "name": "nativeType",
      "description": "原生 button 的 type",
      "default": "\"button\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"button\" | \"submit\" | \"reset\" | undefined"
      }
    }
  ],
  "events": [
    {
      "name": "click"
    }
  ],
  "slots": [
    {
      "name": "default"
    }
  ]
}

{
  "name": "MMenu",
  "source": {
    "module": "@shuimo-design/ui",
    "symbol": "MMenu"
  },
  "attributes": [
    {
      "name": "data",
      "description": "菜单数据；不传则用默认插槽手写 MMenuItem",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuItemData[] | undefined"
      }
    },
    {
      "name": "fieldNames",
      "description": "字段名映射",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuFieldNames | undefined"
      }
    },
    {
      "name": "defaultExpandAll",
      "description": "初始展开全部子菜单",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "modelValue",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuKey | undefined"
      }
    },
    {
      "name": "expandedKeys",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuKey[] | undefined"
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "当前项变化（点叶子项），参数是新 key"
    },
    {
      "name": "update:expandedKeys"
    },
    {
      "name": "nodeClick",
      "description": "点击菜单项（禁用项不触发）；键盘回车 / 空格也算"
    },
    {
      "name": "expand",
      "description": "子菜单展开 / 收起"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "手写的 MMenuItem"
    },
    {
      "name": "label",
      "description": "传 data 时自定义每项文字，作用域 { item, level }"
    }
  ]
}

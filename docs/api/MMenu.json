{
  "name": "MMenu",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MMenu"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MMenu"
    }
  },
  "attributes": [
    {
      "name": "data",
      "description": "菜单数据；不传则用默认插槽手写 MMenuItem",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuItemData[] | undefined"
      },
      "react": {
        "name": "data"
      }
    },
    {
      "name": "fieldNames",
      "description": "字段名映射",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuFieldNames | undefined"
      },
      "react": {
        "name": "fieldNames"
      }
    },
    {
      "name": "defaultExpandAll",
      "description": "初始展开全部子菜单",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "defaultExpandAll"
      }
    },
    {
      "name": "modelValue",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuKey | undefined"
      },
      "react": {
        "name": "value",
        "extra": [
          "defaultValue",
          "onValueChange"
        ]
      }
    },
    {
      "name": "expandedKeys",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "MenuKey[] | undefined"
      },
      "react": {
        "name": "expandedKeys",
        "extra": [
          "defaultExpandedKeys",
          "onExpandedKeysChange"
        ]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "update:expandedKeys"
    },
    {
      "name": "nodeClick",
      "description": "点击菜单项（禁用项不触发）；键盘回车 / 空格也算",
      "react": {
        "name": "onNodeClick"
      }
    },
    {
      "name": "change",
      "description": "当前项变化（点叶子项），参数是新 key",
      "react": {
        "name": "onChange"
      }
    },
    {
      "name": "expand",
      "description": "子菜单展开 / 收起",
      "react": {
        "name": "onExpand"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "手写的 MMenuItem",
      "react": {
        "name": "children"
      }
    },
    {
      "name": "label",
      "description": "传 data 时自定义每项文字，作用域 { item, level }",
      "react": {
        "name": "renderLabel"
      }
    }
  ]
}

{
  "name": "MDarkMode",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MDarkMode"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MDarkMode"
    }
  },
  "attributes": [
    {
      "name": "disabled",
      "description": "禁用：不可点",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "autoMode",
      "description": "没有 v-model 也没有本地记录时，写 data-theme=\"system\" 跟随系统深浅偏好。默认 false：库默认亮色纸，不替使用方决定",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "autoMode"
      }
    },
    {
      "name": "rotate",
      "description": "太极缓慢自转，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "rotate"
      }
    },
    {
      "name": "storageKey",
      "description": "记住选择用的 localStorage 键，默认 \"shuimo-theme\"（值是 dark / light）；false 不记",
      "default": "\"shuimo-theme\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | false | undefined"
      },
      "react": {
        "name": "storageKey"
      }
    },
    {
      "name": "transition",
      "description": "切换时整页墨迹擦过（View Transitions），默认 true；不支持的浏览器直接切",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "transition"
      }
    },
    {
      "name": "modelValue",
      "description": "是否深色；undefined 表示还没选过（autoMode 下跟随系统）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "dark",
        "extra": ["defaultDark", "onDarkChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "用户点击切换后，参数是切换后是否为深色",
      "react": {
        "name": "onChange"
      }
    }
  ],
  "slots": []
}

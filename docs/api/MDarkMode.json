{
  "name": "MDarkMode",
  "source": {
    "module": "@shuimo-design/ui",
    "symbol": "MDarkMode"
  },
  "attributes": [
    {
      "name": "disabled",
      "description": "禁用：不可点",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "autoMode",
      "description": "没有 v-model 也没有本地记录时，写 data-theme=\"system\" 跟随系统深浅偏好。默认 false：库默认亮色纸，不替使用方决定",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "rotate",
      "description": "太极缓慢自转，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "storageKey",
      "description": "记住选择用的 localStorage 键，默认 \"shuimo-theme\"（值是 dark / light）；false 不记",
      "default": "DARK_MODE_STORAGE_KEY",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | false | undefined"
      }
    },
    {
      "name": "transition",
      "description": "切换时整页墨迹擦过（View Transitions），默认 true；不支持的浏览器直接切",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    },
    {
      "name": "modelValue",
      "default": "undefined",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "用户点击切换后，参数是切换后是否为深色"
    }
  ],
  "slots": []
}

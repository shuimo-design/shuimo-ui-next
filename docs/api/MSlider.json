{
  "name": "MSlider",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MSlider"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MSlider"
    }
  },
  "attributes": [
    {
      "name": "min",
      "description": "最小值，默认 0",
      "default": "0",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "min"
      }
    },
    {
      "name": "max",
      "description": "最大值，默认 100",
      "default": "100",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "max"
      }
    },
    {
      "name": "step",
      "description": "步长，默认 1；值会对齐到步长格点",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "step"
      }
    },
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "range",
      "description": "范围选择：v-model 是 [起点, 终点]，显示两个滑块",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "range"
      }
    },
    {
      "name": "showInfo",
      "description": "在轨道上方显示 min、当前百分比、max 一行信息，默认 false",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "showInfo"
      }
    },
    {
      "name": "showTooltip",
      "description": "拖动或悬停时在滑块上方显示当前值，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "showTooltip"
      }
    },
    {
      "name": "formatTooltip",
      "description": "自定义气泡文字",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "((value: number) => string) | undefined"
      },
      "react": {
        "name": "formatTooltip"
      }
    },
    {
      "name": "modelValue",
      "description": "滑块的值；range 模式下是 [起, 止]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | [number, number] | undefined"
      },
      "react": {
        "name": "value",
        "extra": ["defaultValue", "onValueChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "松手 / 键盘调整后的最终值",
      "react": {
        "name": "onChange"
      }
    },
    {
      "name": "input",
      "description": "拖动过程中每次值变化",
      "react": {
        "name": "onInput"
      }
    }
  ],
  "slots": []
}

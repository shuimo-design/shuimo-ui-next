{
  "name": "MScroll",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MScroll"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MScroll"
    }
  },
  "attributes": [
    {
      "name": "height",
      "description": "视口高度，数字按 px；不传则由外层容器（或自身 CSS）决定",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "height"
      }
    },
    {
      "name": "maxHeight",
      "description": "视口最大高度，数字按 px；内容不够高时不撑满",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "maxHeight"
      }
    },
    {
      "name": "always",
      "description": "一直显示滚动条；默认只在悬停、滚动、拖动时浮现",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "always"
      }
    },
    {
      "name": "minThumb",
      "description": "滑块最短长度 px，默认 20，内容极长时滑块也不会缩成一点",
      "default": "20",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "minThumb"
      }
    }
  ],
  "events": [
    {
      "name": "scroll",
      "description": "视口滚动时触发，参数是当前滚动位置",
      "react": {
        "name": "onScroll"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "要滚动的内容",
      "react": {
        "name": "children"
      }
    }
  ]
}

{
  "name": "MDrawer",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MDrawer"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MDrawer"
    }
  },
  "attributes": [
    {
      "name": "mask",
      "description": "遮罩：false 不显示底色；对象可分别控制 show（显示）与 clickClose（点外面关闭），默认都开",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | ModalMask | undefined"
      },
      "react": {
        "name": "mask"
      }
    },
    {
      "name": "direction",
      "description": "从哪条边滑出，默认 right",
      "default": "\"right\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "DrawerDirection | undefined"
      },
      "react": {
        "name": "direction"
      }
    },
    {
      "name": "size",
      "description": "左右抽屉是宽度、上下抽屉是高度，数字按 px；默认 320px，也可覆盖 CSS 变量 --m-drawer-size",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "size"
      }
    },
    {
      "name": "closeBtn",
      "description": "显示关闭按钮，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "closeBtn"
      }
    },
    {
      "name": "closeOnEsc",
      "description": "按 ESC 关闭，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "closeOnEsc"
      }
    },
    {
      "name": "title",
      "description": "标题；也可用 header 插槽",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "title"
      }
    },
    {
      "name": "teleport",
      "description": "传送目标：true 到 body，字符串为选择器，false 原地渲染，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | boolean | undefined"
      },
      "react": {
        "name": "teleport"
      }
    },
    {
      "name": "seed",
      "description": "边缘笔触线的随机种子，默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    },
    {
      "name": "modelValue",
      "description": "是否显示",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "open",
        "extra": ["defaultOpen", "onOpenChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "open",
      "description": "变为显示",
      "react": {
        "name": "onOpen"
      }
    },
    {
      "name": "close",
      "description": "变为隐藏（关闭按钮、ESC、点遮罩或外部改 v-model 都会触发）",
      "react": {
        "name": "onClose"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "抽屉内容",
      "react": {
        "name": "children"
      }
    },
    {
      "name": "active",
      "description": "触发元素：点一下就打开",
      "react": {
        "name": "active"
      }
    },
    {
      "name": "header",
      "description": "头部，替代 title",
      "react": {
        "name": "header"
      }
    },
    {
      "name": "footer",
      "description": "底部操作区",
      "react": {
        "name": "footer"
      }
    }
  ]
}

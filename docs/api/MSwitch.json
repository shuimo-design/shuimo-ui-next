{
  "name": "MSwitch",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MSwitch"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MSwitch"
    }
  },
  "attributes": [
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "loading",
      "description": "加载中：滑钮缓慢旋转且不可操作",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "loading"
      }
    },
    {
      "name": "activeValue",
      "description": "打开时 v-model 取的值，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "SwitchValue | undefined"
      },
      "react": {
        "name": "activeValue"
      }
    },
    {
      "name": "inactiveValue",
      "description": "关闭时 v-model 取的值，默认 false",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "SwitchValue | undefined"
      },
      "react": {
        "name": "inactiveValue"
      }
    },
    {
      "name": "activeText",
      "description": "打开态文字（显示在开关左侧）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "activeText"
      }
    },
    {
      "name": "inactiveText",
      "description": "关闭态文字（显示在开关右侧）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "inactiveText"
      }
    },
    {
      "name": "controlled",
      "description": "受控：点击只发 change，不自己改 v-model，由外部决定要不要切换",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "controlled"
      }
    },
    {
      "name": "name",
      "description": "原生 name",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "name"
      }
    },
    {
      "name": "modelValue",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "SwitchValue | undefined"
      },
      "react": {
        "name": "value",
        "extra": [
          "defaultValue",
          "onValueChange"
        ]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "用户切换后，参数是（将要变成的）新值",
      "react": {
        "name": "onChange"
      }
    }
  ],
  "slots": [
    {
      "name": "active",
      "description": "替代 activeText",
      "react": {
        "name": "active"
      }
    },
    {
      "name": "inactive",
      "description": "替代 inactiveText",
      "react": {
        "name": "inactive"
      }
    }
  ]
}

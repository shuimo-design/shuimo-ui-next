    {
      "name": "name",
      "description": "原生 name；在 RadioGroup 里时以组的 name 为准",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      }
    },
    {
      "name": "modelValue",
      "required": false,
      "value": {

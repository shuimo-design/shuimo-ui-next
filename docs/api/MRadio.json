{
  "name": "MRadio",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MRadio"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MRadio"
    }
  },
  "attributes": [
    {
      "name": "value",
      "description": "这一项代表的值；选中后写进 v-model",
      "required": true,
      "value": {
        "kind": "expression",
        "type": "RadioValue"
      },
      "react": {
        "name": "value"
      }
    },
    {
      "name": "label",
      "description": "文字；默认插槽优先",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "label"
      }
    },
    {
      "name": "disabled",
      "description": "禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "name",
      "description": "原生 name；在 RadioGroup 里时以组的 name 为准",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "name"
      }
    },
    {
      "name": "modelValue",
      "description": "选中的值；单独用（不在 MRadioGroup 里）时才需要",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "RadioValue | undefined"
      },
      "react": {
        "name": "checked",
        "extra": ["defaultChecked", "onCheckedChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "用户操作选中了这一项",
      "react": {
        "name": "onChange"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "单选框的文字；给了就盖掉 label 属性",
      "react": {
        "name": "children"
      }
    }
  ]
}

{
  "name": "MBackTop",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MBackTop"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MBackTop"
    }
  },
  "attributes": [
    {
      "name": "target",
      "description": "监听哪个滚动容器：CSS 选择器，或一个返回元素的函数；不传就是整页",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | (() => HTMLElement) | undefined"
      },
      "react": {
        "name": "target"
      }
    },
    {
      "name": "visibilityHeight",
      "description": "滚过多少 px 才出现，默认 200",
      "default": "200",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "visibilityHeight"
      }
    },
    {
      "name": "right",
      "description": "距视口右边的距离，数字按 px，默认 40",
      "default": "40",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "right"
      }
    },
    {
      "name": "bottom",
      "description": "距视口底部的距离，数字按 px，默认 40",
      "default": "40",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "bottom"
      }
    },
    {
      "name": "seed",
      "description": "默认那枚印的随机种子，默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    }
  ],
  "events": [
    {
      "name": "click",
      "description": "点了按钮；随后滚回顶部",
      "react": {
        "name": "onClick"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "替换按钮内容；默认是一枚印文「顶」的小方印",
      "react": {
        "name": "children"
      }
    }
  ]
}

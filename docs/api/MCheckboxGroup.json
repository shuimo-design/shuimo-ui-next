{
  "name": "MCheckboxGroup",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MCheckboxGroup"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MCheckboxGroup"
    }
  },
  "attributes": [
    {
      "name": "disabled",
      "description": "整组禁用",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "disabled"
      }
    },
    {
      "name": "min",
      "description": "至少勾选几个；到下限后剩余已选项不可取消",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "min"
      }
    },
    {
      "name": "max",
      "description": "最多勾选几个；到上限后未选项不可再选",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "max"
      }
    },
    {
      "name": "direction",
      "description": "横排（默认）还是竖排",
      "default": "\"horizontal\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"horizontal\" | \"vertical\" | undefined"
      },
      "react": {
        "name": "direction"
      }
    },
    {
      "name": "modelValue",
      "description": "组内选中的值，顺序按勾选先后",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "CheckboxValue[] | undefined"
      },
      "react": {
        "name": "value",
        "extra": ["defaultValue", "onValueChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "change",
      "description": "组内选中项变化，参数是变化后的全部选中值",
      "react": {
        "name": "onChange"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "放 MCheckbox",
      "react": {
        "name": "children"
      }
    }
  ]
}

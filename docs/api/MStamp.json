{
  "name": "MStamp",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MStamp"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MStamp"
    }
  },
  "attributes": [
    {
      "name": "text",
      "description": "印文：字符串自动分列（竖排、从右往左读）；数组每项是一列，第一项在最右",
      "required": true,
      "value": {
        "kind": "expression",
        "type": "string | string[]"
      },
      "react": {
        "name": "text"
      }
    },
    {
      "name": "size",
      "description": "印章高度（px），宽度按印文和形状算出来",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "size"
      }
    },
    {
      "name": "mode",
      "description": "阳文（朱文，红字红框）还是阴文（白文，红底白字）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "StampMode | undefined"
      },
      "react": {
        "name": "mode"
      }
    },
    {
      "name": "shape",
      "description": "外形：auto 贴着印文、square 方、rect 长方、circle 圆、ellipse 椭圆、polygon 多边形",
      "default": "\"auto\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "StampShape | undefined"
      },
      "react": {
        "name": "shape"
      }
    },
    {
      "name": "aspect",
      "description": "宽高比，rect / ellipse / polygon 用",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "aspect"
      }
    },
    {
      "name": "sides",
      "description": "多边形边数（3 起），默认 6",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "sides"
      }
    },
    {
      "name": "orientation",
      "description": "多边形朝向：flat-top 一条边在上，point-top 一个角在上",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "PolygonOrientation | undefined"
      },
      "react": {
        "name": "orientation"
      }
    },
    {
      "name": "seed",
      "description": "随机种子：四角半径、边框磨损、印泥白斑都由它决定，同种子同章",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    },
    {
      "name": "color",
      "description": "印泥色，默认 --m-seal（朱砂）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "color"
      }
    },
    {
      "name": "font",
      "description": "这一枚的字体族，默认跟随 `--m-font-seal`。\n换全局的字体不用逐枚传：自己 `@font-face` 引好，再把 `--m-font-seal` 指过去就行。\n无论哪种，启动时调一次 `preloadStampFont()`，第一枚印章才不会先排一版兜底再跳。",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "font"
      }
    },
    {
      "name": "border",
      "description": "边框厚度（px），默认 size × 3.5%",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "border"
      }
    },
    {
      "name": "corner",
      "description": "圆角：round 带一点随机的圆角，none 直角",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "StampCorner | undefined"
      },
      "react": {
        "name": "corner"
      }
    },
    {
      "name": "cornerRadius",
      "description": "圆角半径（px），默认短边 4%",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "cornerRadius"
      }
    },
    {
      "name": "roughness",
      "description": "边框磨损 0 ~ 1：一圈起伏加几个咬进边框的缺口，默认 0.5",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "roughness"
      }
    },
    {
      "name": "carving",
      "description": "刀刻 0 ~ 1：文字边缘的崩口和石屑，默认 0.8",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "carving"
      }
    },
    {
      "name": "bleed",
      "description": "印泥 0 ~ 1：没压实的白斑和边缘起毛，默认 0.7",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "bleed"
      }
    },
    {
      "name": "padding",
      "description": "文字到边框的内边距（px），默认 size × 1.5%",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "padding"
      }
    },
    {
      "name": "gap",
      "description": "字距和列距（px），默认 size × 1%",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "gap"
      }
    },
    {
      "name": "rowGap",
      "description": "同列字与字的距离，覆盖 gap",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "rowGap"
      }
    },
    {
      "name": "columnGap",
      "description": "列与列的距离，覆盖 gap",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "columnGap"
      }
    },
    {
      "name": "columns",
      "description": "字符串印文分几列，默认按字数取近似方形",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "columns"
      }
    },
    {
      "name": "stretch",
      "description": "每个字非等比撑满格子（九叠篆那种）；方 / 圆 / 多边形默认开",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "stretch"
      }
    },
    {
      "name": "cellHeightMode",
      "description": "行高分配：uniform 等分，fit 按各行最高的字分（矮字不留空）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"uniform\" | \"fit\" | undefined"
      },
      "react": {
        "name": "cellHeightMode"
      }
    },
    {
      "name": "offsetX",
      "description": "文字在框内左右偏移，-1 贴右、0 居中、1 贴左",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "offsetX"
      }
    },
    {
      "name": "offsetY",
      "description": "文字在框内上下偏移，-1 贴上、0 居中、1 贴下",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "offsetY"
      }
    },
    {
      "name": "direction",
      "description": "ttb-rtl 竖排；circular 沿圆周排（圆章用）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "StampDirection | undefined"
      },
      "react": {
        "name": "direction"
      }
    },
    {
      "name": "gridLines",
      "description": "阴章的界格：列与列、行与行之间抠一道纸色",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "gridLines"
      }
    },
    {
      "name": "gridLineWidth",
      "description": "界格线宽（px），默认字号 6%",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "gridLineWidth"
      }
    },
    {
      "name": "rotate",
      "description": "盖章的歪斜角度（deg）",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "rotate"
      }
    }
  ],
  "events": [],
  "slots": []
}

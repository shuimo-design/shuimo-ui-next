{
  "name": "MGrid",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MGrid"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MGrid"
    }
  },
  "attributes": [
    {
      "name": "cells",
      "description": "每个格子的配置，顺序就是排列顺序；不传则从子组件 MCell 上收集",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "readonly GridCellConfig<unknown>[] | undefined"
      },
      "react": {
        "name": "cells"
      }
    },
    {
      "name": "w",
      "description": "格子的默认宽 px；格子自己传了 w 以自己的为准",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "w"
      }
    },
    {
      "name": "h",
      "description": "格子的默认高 px；格子自己传了 h 以自己的为准",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "h"
      }
    },
    {
      "name": "gap",
      "description": "格子之间的间距，数字按 px，字符串原样用",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "gap"
      }
    },
    {
      "name": "colGap",
      "description": "横向排列时格子之间的间距，优先于 gap",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "colGap"
      }
    },
    {
      "name": "rowGap",
      "description": "纵向排列时格子之间的间距，优先于 gap",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "rowGap"
      }
    },
    {
      "name": "gapRotate",
      "description": "横向排列时每道分隔的倾斜角度（度），第 i 项作用在第 i 和 i+1 个格子之间；正值为 \"/\"，负值为 \"\\\"",
      "default": "[]",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number[] | undefined"
      },
      "react": {
        "name": "gapRotate"
      }
    },
    {
      "name": "direction",
      "description": "排列方向，默认 row",
      "default": "\"row\"",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "\"row\" | \"column\" | undefined"
      },
      "react": {
        "name": "direction"
      }
    },
    {
      "name": "cols",
      "description": "列数；传了就切成等宽的网格，格子用 span / offset 占位，gapRotate 不再生效",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "GridCols | undefined"
      },
      "react": {
        "name": "cols"
      }
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": "放 MCell（语法糖；传了 cells 就不看这里）",
      "react": {
        "name": "children"
      }
    }
  ]
}

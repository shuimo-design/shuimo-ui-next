{
  "name": "MDialog",
  "source": {
    "vue": {
      "module": "@shuimo-design/vue",
      "symbol": "MDialog"
    },
    "react": {
      "module": "@shuimo-design/react",
      "symbol": "MDialog"
    }
  },
  "attributes": [
    {
      "name": "mask",
      "description": "遮罩：false 不显示底色；对象可分别控制 show（显示）与 clickClose（点外面关闭），默认都开",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | ModalMask | undefined"
      },
      "react": {
        "name": "mask"
      }
    },
    {
      "name": "closeBtn",
      "description": "显示右上角的挂牌关闭按钮，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "closeBtn"
      }
    },
    {
      "name": "closeOnEsc",
      "description": "按 ESC 关闭，默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "closeOnEsc"
      }
    },
    {
      "name": "title",
      "description": "标题；也可用 header 插槽",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | undefined"
      },
      "react": {
        "name": "title"
      }
    },
    {
      "name": "width",
      "description": "宽度，数字按 px；默认 min(560px, 100vw - 32px)，也可覆盖 CSS 变量 --m-dialog-w",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "width"
      }
    },
    {
      "name": "height",
      "description": "高度，数字按 px；默认随内容，也可覆盖 CSS 变量 --m-dialog-h",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | number | undefined"
      },
      "react": {
        "name": "height"
      }
    },
    {
      "name": "teleport",
      "description": "传送目标：true 到 body，字符串为选择器，false 原地渲染（测试或受限容器用），默认 true",
      "default": "true",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "string | boolean | undefined"
      },
      "react": {
        "name": "teleport"
      }
    },
    {
      "name": "seed",
      "description": "笔触与角饰的随机种子，默认 1",
      "default": "1",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "number | undefined"
      },
      "react": {
        "name": "seed"
      }
    },
    {
      "name": "modelValue",
      "description": "是否显示",
      "default": "false",
      "required": false,
      "value": {
        "kind": "expression",
        "type": "boolean | undefined"
      },
      "react": {
        "name": "open",
        "extra": ["defaultOpen", "onOpenChange"]
      }
    }
  ],
  "events": [
    {
      "name": "update:modelValue"
    },
    {
      "name": "open",
      "description": "变为显示",
      "react": {
        "name": "onOpen"
      }
    },
    {
      "name": "close",
      "description": "变为隐藏（关闭按钮、ESC、点遮罩或外部改 v-model 都会触发）",
      "react": {
        "name": "onClose"
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "弹窗内容",
      "react": {
        "name": "children"
      }
    },
    {
      "name": "active",
      "description": "触发元素：点一下就打开，省去自己维护 v-model",
      "react": {
        "name": "active"
      }
    },
    {
      "name": "header",
      "description": "头部，替代 title",
      "react": {
        "name": "header"
      }
    },
    {
      "name": "footer",
      "description": "底部操作区",
      "react": {
        "name": "footer"
      }
    }
  ]
}
